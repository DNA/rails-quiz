h2 Creating an entry

- if @person.errors.any?
  .alert.alert-danger
    - @person.errors.full_messages.each do |message|
      =message
      br

= form_for @person, class: 'row' do |f|
  .col-auto
    = f.label :name, class: 'form-label'
    = f.text_field :name, class: 'form-control', value: @person.name
  .col-auto
    = f.label :phone_number, class: 'form-label'
    = f.text_field :phone_number, class: 'form-control', value: @person.phone_number
  .col-auto
    = f.label :email, class: 'form-label'
    = f.text_field :email, class: 'form-control', value: @person.email
  .col-auto.mt-4
    = f.submit class: 'btn btn-primary'
